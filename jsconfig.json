{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx"
  },
  "include": ["sanity.config.js", "sanity.cli.js", "schemaTypes/**/*.js"],
  "exclude": ["node_modules", "dist"]
}
